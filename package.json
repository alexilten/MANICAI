{
  "name": "manicai",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "MANICAI — generative stadium design engine: parametric seating bowl, live capacity and sightlines, native Rhino export",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "vite-node scripts/bench.ts",
    "export:samples": "vite-node scripts/export-samples.ts",
    "docs": "vite-node scripts/gen-docs.ts",
    "verify:3dm": "python3 scripts/verify_3dm.py samples/*.3dm",
    "verify:ifc": "python3 scripts/verify_ifc.py samples/*.ifc",
    "verify:dxf": "python3 scripts/verify_dxf.py samples/*.dxf"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rhino3dm": "^8.35.0",
    "three": "^0.180.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
